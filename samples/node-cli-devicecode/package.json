    "@mohsinonxrm/dataverse-sdk-functions": "workspace:*",
    "@azure/msal-node": "^2.15.0",
    "chalk": "^5.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
