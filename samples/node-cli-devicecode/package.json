{
  "name": "node-cli-devicecode-sample",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Interactive Node.js CLI demonstrating device code authentication with Dataverse SDK",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
