{
  "name": "@mohsinonxrm/dataverse-sdk-messages",
  "version": "2.0.0-beta.1",
  "description": "Organization Service messages for Dataverse with typed request/response pairs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-messages"
  },
  "keywords": [
    "dataverse",
    "dynamics",
    "crm",
    "messages",
    "organizationrequest",
    "sdk-messages",
    "xrm",
    "microsoft",
    "power-platform"
  ],
  "type": "module",
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm run test:types",
    "test:types": "tsd --files test/types.test-d.ts --files test/return-shapes.test-d.ts --files test/root-types.test-d.ts --files test/handwritten.test-d.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mohsinonxrm/dataverse-sdk-batch": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-entities-runtime": "workspace:*"
  },
  "devDependencies": {
    "@mohsinonxrm/dataverse-sdk-testing": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
