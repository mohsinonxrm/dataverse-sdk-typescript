{
  "name": "@mohsinonxrm/dataverse-sdk-generator",
  "version": "1.0.0",
  "type": "module",
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-generator"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dataverse-gen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.3",
    "@mohsinonxrm/dataverse-sdk-auth-msal-node": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-entities-runtime": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-metadata": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "ora": "^8.2.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@mohsinonxrm/dataverse-sdk-testing": "workspace:^",
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
