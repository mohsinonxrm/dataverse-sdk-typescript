<%# Patterned on the templates of dataverse-gen by Scott Durow (https://github.com/scottdurow/dataverse-gen), Copyright (c) 2020 Scott Durow, MIT License. See THIRD_PARTY_NOTICES.md in this package. -%>
/**
 * <%- doc(entity.SchemaName || entity.Name) %> entity
 * Logical Name: <%- doc(entity.LogicalName) %>
 * Entity Set: <%- doc(entity.EntitySetName) %>
 */
export interface <%- typeName %> extends IEntity {
  logicalName: <%- literal(entity.LogicalName) %>;
<%_ entity.Properties.forEach(function(prop){ _%>

  /** <%- doc(prop.Description || prop.DisplayName || prop.LogicalName) %> */
  <%- propertyKey(prop.Name) %>?: <%- formatType(prop.TypeScriptType) %><%- prop.Nullable ? ' | null' : '' %>;<%- getSourceTypeComment(prop.SourceType) %>
<%_ }) _%>
<%_ entity.NavigationProperties.forEach(function(nav){ _%>

  /** Navigation: <%- doc(nav.RelationshipName) %><%- nav.IsPolymorphic ? doc(' (polymorphic: ' + (nav.Targets || []).join(', ') + ')') : '' %> */
  <%- propertyKey(nav.Name) %>?: <%- navigationType(nav) %>;
<%_ }) _%>
}

/**
 * Metadata for the <%- doc(entity.LogicalName) %> entity
 */
export const <%- metadataName %>: EntityMetadata = {
  typeName: <%- literal(entity.TypeName) %>,
  logicalName: <%- literal(entity.LogicalName) %>,
  collectionName: <%- literal(entity.EntitySetName) %>,
  primaryIdAttribute: <%- literal(entity.KeyName) %>,
  <%_ if (entity.PrimaryNameAttribute) { _%>
  primaryNameAttribute: <%- literal(entity.PrimaryNameAttribute) %>,
  <%_ } _%>
  attributeTypes: {
<%_ entity.Properties.forEach(function(prop){ _%>
    <%- propertyKey(prop.LogicalName) %>: <%- literal(prop.Type) %>,
<%_ }) _%>
  },
  attributes: {
<%_ entity.Properties.forEach(function(prop){ _%>
    <%- propertyKey(prop.LogicalName) %>: {
      logicalName: <%- literal(prop.LogicalName) %>,
      schemaName: <%- literal(prop.SchemaName || prop.Name) %>,
      attributeType: <%- literal(prop.AttributeType || prop.Type) %>,
      typescriptType: <%- literal(formatType(prop.TypeScriptType)) %>,
      odataType: <%- literal(prop.Type) %>,
      <%_ if (prop.IsRequired) { _%>
      isRequired: true,
      <%_ } _%>
      <%_ if (prop.SourceType === 1) { _%>
      sourceType: "calculated",
      <%_ } else if (prop.SourceType === 2) { _%>
      sourceType: "rollup",
      <%_ } _%>
      <%_ if (prop.Targets && prop.Targets.length > 0) { _%>
      targets: <%- literal(prop.Targets) %>,
      <%_ } _%>
      <%_ if (prop.EnumName) { _%>
      optionSetType: <%- literal(prop.EnumName) %>,
      <%_ } _%>
      <%_ if (prop.IsMultiSelect) { _%>
      isMultiSelect: true,
      <%_ } _%>
    },
<%_ }) _%>
  },
  navigation: {
<%_ entity.NavigationProperties.forEach(function(nav){ _%>
    <%- propertyKey(nav.Name) %>: {
      name: <%- literal(nav.Name) %>,
      <%_ if (nav.FullName) { _%>
      fullName: <%- literal(nav.FullName) %>,
      <%_ } _%>
      targetType: <%- literal(nav.TargetType) %>,
      <%_ if (nav.IsPolymorphic) { _%>
      isPolymorphic: true,
      targets: <%- literal(nav.Targets || []) %>,
      <%_ } _%>
      isCollection: <%- nav.IsCollection ? 'true' : 'false' %>,
      relationshipName: <%- literal(nav.RelationshipName) %>,
    },
<%_ }) _%>
  },
};
