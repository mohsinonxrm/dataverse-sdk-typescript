<%_ if (action.Parameters.length > 0) { _%>
/**
 * Parameters of the <%- doc(action.Name) %> action, by their CSDL names. A parameter the CSDL
 * declares nullable is optional, and left out of the request when it's undefined.
 */
export interface <%- parametersName %> {
<%_ action.Parameters.forEach(function(param){ _%>
  <%- propertyKey(param.Name) %><%- param.Nullable ? '?' : '' %>: <%- parameterType(param) %><%- param.Nullable ? ' | null' : '' %>;
<%_ }) _%>
}

<%_ } _%>
<%_ if (responseDeclaration) { _%>
<%- responseDeclaration %>
<%_ } _%>
/**
 * <%- doc(action.Name) %> action
 * <%- action.IsBound ? 'Bound to: ' + doc(action.BindingType) : 'Unbound action' %>
<%_ if (bindingDoc) { _%>
 *
 * <%- bindingDoc %>
<%_ } _%>
 */
export class <%- className %> extends ActionBase<<%- responseType %>> {
<%_ if (constructorParameters.length > 0) { _%>
<%_ constructorParameters.forEach(function(p){ _%>
  public readonly <%- p.name %>: <%- p.type %>;
<%_ }) _%>

  constructor(
<%_ constructorParameters.forEach(function(p){ _%>
    <%- p.name %>: <%- p.type %><%- p.defaultValue !== undefined ? ' = ' + p.defaultValue : '' %>,
<%_ }) _%>
  ) {
    super();
<%_ constructorParameters.forEach(function(p){ _%>
    this.<%- p.name %> = <%- p.name %>;
<%_ }) _%>
  }

<%_ } _%>
  /**
   * Parameter metadata for runtime type checking
   */
  static parameterTypes = {
<%_ action.Parameters.forEach(function(param){ _%>
    <%- propertyKey(param.Name) %>: {
      type: <%- literal(param.Type) %>,
      structuralProperty: <%- literal(getStructuralType(param.Type)) %>,
      nullable: <%- param.Nullable ? 'true' : 'false' %>,
    },
<%_ }) _%>
  };

  toRequestInformation(baseUrl: string): RequestInformation {
<%_ if (action.Parameters.length > 0) { _%>
    // The parameters by their CSDL names; an undefined one isn't sent. Enum values are sent as
    // member names, and entities with their lookups as @odata.bind (bodyValue).
    const body: Record<string, unknown> = {};
<%_ action.Parameters.forEach(function(param){ _%>
    if (this.parameters<%- access(param.Name) %> !== undefined) body[<%- literal(param.Name) %>] = <%- bodyExpression(param) %>;
<%_ }) _%>

<%_ } _%>
    return {
      method: "POST",
      url: `${baseUrl}<%- operationPath %>`,
      headers: {
        "content-type": "application/json",
        accept: "application/json",
      },
      body: <%- action.Parameters.length > 0 ? 'body' : '{}' %>,
    };
  }

<%- parseResponse -%>
}
