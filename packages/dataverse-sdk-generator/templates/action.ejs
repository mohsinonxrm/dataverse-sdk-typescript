<%_ const responseType = action.ReturnType ? formatType(action.ReturnType) : 'void'; _%>
/**
 * <%- doc(action.Name) %> action
 * <%- action.IsBound ? 'Bound to: ' + doc(action.BindingType) : 'Unbound action' %>
 */
export class <%- className %> extends ActionBase<<%- responseType %>> {
  constructor(
<%_ action.Parameters.forEach(function(param){ _%>
    public <%- identifier(param.Name) %>: <%- formatType(param.TypeScriptType) %><%- param.Nullable ? ' | null' : '' %>,
<%_ }) _%>
  ) {
    super();
  }

  /**
   * Parameter metadata for runtime type checking
   */
  static parameterTypes = {
<%_ action.Parameters.forEach(function(param){ _%>
    <%- propertyKey(param.Name) %>: {
      type: <%- literal(param.Type) %>,
      structuralProperty: <%- literal(getStructuralType(param.Type)) %>,
      nullable: <%- param.Nullable ? 'true' : 'false' %>,
    },
<%_ }) _%>
  };

  toRequestInformation(baseUrl: string): RequestInformation {
    return {
      method: "POST",
      url: `${baseUrl}/<%- action.Name %>`,
      headers: {
        "content-type": "application/json",
        accept: "application/json",
      },
      body: {
<%_ action.Parameters.forEach(function(param){ _%>
        <%- propertyKey(param.Name) %>: this.<%- identifier(param.Name) %>,
<%_ }) _%>
      },
    };
  }

<%_ if (!action.ReturnType) { _%>
  async parseResponse(_response: Response): Promise<void> {
    // 204 No Content
  }
<%_ } else if (returnsBody(action.ReturnType)) { _%>
  async parseResponse(response: Response): Promise<<%- responseType %>> {
    return (await response.json()) as <%- responseType %>;
  }
<%_ } else { _%>
  async parseResponse(response: Response): Promise<<%- responseType %>> {
    const data = (await response.json()) as { value: <%- responseType %> };
    return data.value;
  }
<%_ } _%>
}
