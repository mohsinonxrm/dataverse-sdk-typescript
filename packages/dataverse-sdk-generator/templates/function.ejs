<%_ const responseType = func.ReturnType ? formatType(func.ReturnType) : 'void'; _%>
/**
 * <%- doc(func.Name) %> function
 * <%- func.IsBound ? 'Bound to: ' + doc(func.BindingType) : 'Unbound function' %>
 */
export class <%- className %> extends FunctionBase<<%- responseType %>> {
  constructor(
<%_ func.Parameters.forEach(function(param){ _%>
    public <%- identifier(param.Name) %>: <%- formatType(param.TypeScriptType) %><%- param.Nullable ? ' | null' : '' %>,
<%_ }) _%>
  ) {
    super();
  }

  /**
   * Parameter metadata for runtime type checking
   */
  static parameterTypes = {
<%_ func.Parameters.forEach(function(param){ _%>
    <%- propertyKey(param.Name) %>: {
      type: <%- literal(param.Type) %>,
      structuralProperty: <%- literal(getStructuralType(param.Type)) %>,
      nullable: <%- param.Nullable ? 'true' : 'false' %>,
    },
<%_ }) _%>
  };

  toRequestInformation(baseUrl: string): RequestInformation {
    // Build parameter aliases for GET request
    const query: Record<string, string> = {};
<%_ func.Parameters.forEach(function(param){ _%>
    query[<%- literal('@' + param.Name) %>] = String(this.<%- identifier(param.Name) %>);
<%_ }) _%>

    return {
      method: "GET",
      url: `${baseUrl}/<%- func.Name %><%- func.Parameters.length > 0 ? '(' + func.Parameters.map(function(p){ return p.Name + '=@' + p.Name; }).join(',') + ')' : '' %>`,
      headers: {
        accept: "application/json",
      },
      query,
    };
  }

<%_ if (!func.ReturnType) { _%>
  async parseResponse(_response: Response): Promise<void> {
    // No return value
  }
<%_ } else if (returnsBody(func.ReturnType)) { _%>
  async parseResponse(response: Response): Promise<<%- responseType %>> {
    return (await response.json()) as <%- responseType %>;
  }
<%_ } else { _%>
  async parseResponse(response: Response): Promise<<%- responseType %>> {
    const data = (await response.json()) as { value: <%- responseType %> };
    return data.value;
  }
<%_ } _%>
}
