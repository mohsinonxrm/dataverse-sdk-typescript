<%_ if (func.Parameters.length > 0) { _%>
/**
 * Parameters of the <%- doc(func.Name) %> function, by their CSDL names. A parameter the CSDL
 * declares nullable is optional, and left out of the request when it's undefined.
 */
export interface <%- parametersName %> {
<%_ func.Parameters.forEach(function(param){ _%>
  <%- propertyKey(param.Name) %><%- param.Nullable ? '?' : '' %>: <%- parameterType(param) %><%- param.Nullable ? ' | null' : '' %>;
<%_ }) _%>
}

<%_ } _%>
<%_ if (responseDeclaration) { _%>
<%- responseDeclaration %>
<%_ } _%>
/**
 * <%- doc(func.Name) %> function
 * <%- func.IsBound ? 'Bound to: ' + doc(func.BindingType) : 'Unbound function' %>
<%_ if (bindingDoc) { _%>
 *
 * <%- bindingDoc %>
<%_ } _%>
 */
export class <%- className %> extends FunctionBase<<%- responseType %>> {
<%_ if (constructorParameters.length > 0) { _%>
<%_ constructorParameters.forEach(function(p){ _%>
  public readonly <%- p.name %>: <%- p.type %>;
<%_ }) _%>

  constructor(
<%_ constructorParameters.forEach(function(p){ _%>
    <%- p.name %>: <%- p.type %><%- p.defaultValue !== undefined ? ' = ' + p.defaultValue : '' %>,
<%_ }) _%>
  ) {
    super();
<%_ constructorParameters.forEach(function(p){ _%>
    this.<%- p.name %> = <%- p.name %>;
<%_ }) _%>
  }

<%_ } _%>
  /**
   * Parameter metadata for runtime type checking
   */
  static parameterTypes = {
<%_ func.Parameters.forEach(function(param){ _%>
    <%- propertyKey(param.Name) %>: {
      type: <%- literal(param.Type) %>,
      structuralProperty: <%- literal(getStructuralType(param.Type)) %>,
      nullable: <%- param.Nullable ? 'true' : 'false' %>,
    },
<%_ }) _%>
  };

  toRequestInformation(baseUrl: string): RequestInformation {
    // Parameters travel as aliases: Name(Param=@p1)?@p1=<OData literal>; an undefined one isn't sent.
    // Enum values inside a complex or collection parameter are sent as member names (parameterValue).
    const aliases: string[] = [];
    const values = new URLSearchParams();
<%_ func.Parameters.forEach(function(param, index){ _%>
    if (this.parameters<%- access(param.Name) %> !== undefined) {
      aliases.push(<%- literal(param.Name + '=@p' + (index + 1)) %>);
      values.append(<%- literal('@p' + (index + 1)) %>, formatParameterAlias(<%- bodyExpression(param) %>, <%- literal(param.Type) %>, <%- literal(parameterKind(param)) %>));
    }
<%_ }) _%>
    const query = values.toString();

    return {
      method: "GET",
      url: `${baseUrl}<%- operationPath %>(${aliases.join(",")})${query ? `?${query}` : ""}`,
      headers: {
        accept: "application/json",
      },
    };
  }

<%- parseResponse -%>
}
