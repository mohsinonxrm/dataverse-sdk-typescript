/**
 * Metadata cache for all generated entities, keyed by logical name
 */
export const EntityMetadataCache: Record<string, <%- metadataType %>> = {
<%_ entities.forEach(function(e){ _%>
  <%- propertyKey(e.entity.LogicalName) %>: <%- e.metadataName %>,
<%_ }) _%>
};

/**
 * Entity name mapping: SchemaName -> LogicalName
 */
export const Entities = {
<%_ entities.forEach(function(e){ _%>
  <%- propertyKey(e.entity.SchemaName || e.entity.Name) %>: <%- literal(e.entity.LogicalName) %>,
<%_ }) _%>
} as const;

/**
 * Get entity metadata by logical name
 */
export function getEntityMetadata(logicalName: string): <%- metadataType %> | undefined {
  return EntityMetadataCache[logicalName];
}

/**
 * Get entity logical name by schema name
 */
export function getLogicalName(schemaName: string): string | undefined {
  return (Entities as Record<string, string>)[schemaName];
}

/**
 * List of all generated entities (logical names)
 */
export const GeneratedEntities = [
<%_ entities.forEach(function(e){ _%>
  <%- literal(e.entity.LogicalName) %>,
<%_ }) _%>
] as const;

/**
 * List of all generated actions
 */
export const GeneratedActions = [
<%_ actions.forEach(function(e){ _%>
  <%- literal(e.op.Name) %>,
<%_ }) _%>
] as const;

/**
 * List of all generated functions
 */
export const GeneratedFunctions = [
<%_ functions.forEach(function(e){ _%>
  <%- literal(e.op.Name) %>,
<%_ }) _%>
] as const;

/**
 * Action metadata for runtime lookup
 */
export const ActionMetadata = {
<%_ actions.forEach(function(e){ _%>
  <%- propertyKey(e.key) %>: {
    name: <%- literal(e.op.Name) %>,
    isBound: <%- e.op.IsBound ? 'true' : 'false' %>,
    <%_ if (e.op.BindingType) { _%>
    bindingType: <%- literal(e.op.BindingType) %>,
    <%_ } _%>
    hasReturnType: <%- e.op.ReturnType ? 'true' : 'false' %>,
  },
<%_ }) _%>
} as const;

/**
 * Function metadata for runtime lookup
 */
export const FunctionMetadata = {
<%_ functions.forEach(function(e){ _%>
  <%- propertyKey(e.key) %>: {
    name: <%- literal(e.op.Name) %>,
    isBound: <%- e.op.IsBound ? 'true' : 'false' %>,
    <%_ if (e.op.BindingType) { _%>
    bindingType: <%- literal(e.op.BindingType) %>,
    <%_ } _%>
    hasReturnType: <%- e.op.ReturnType ? 'true' : 'false' %>,
  },
<%_ }) _%>
} as const;
