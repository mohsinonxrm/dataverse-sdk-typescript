{
  "name": "@mohsinonxrm/dataverse-sdk-functions",
  "version": "0.0.1",
  "description": "Typed Web API functions for Dataverse (GET operations without side effects)",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-functions"
  },
  "keywords": [
    "dataverse",
    "dynamics",
    "crm",
    "functions",
    "web-api",
    "odata",
    "microsoft",
    "power-platform"
  ],
  "type": "module",
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "eslint": "^9.0.0"
  }
}
