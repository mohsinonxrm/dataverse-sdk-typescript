{
  "name": "@mohsinonxrm/dataverse-sdk-appinsights",
  "version": "2.0.0",
  "description": "Application Insights telemetry adapter for Dataverse SDK",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-appinsights"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "keywords": [
    "dataverse",
    "dynamics365",
    "telemetry",
    "application-insights",
    "monitoring"
  ],
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@microsoft/applicationinsights-web": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/resources": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@azure/monitor-opentelemetry": {
      "optional": true
    },
    "@microsoft/applicationinsights-web": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    }
  },
  "devDependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@microsoft/applicationinsights-web": "3.4.6",
    "@mohsinonxrm/dataverse-sdk-testing": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^3.1.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
