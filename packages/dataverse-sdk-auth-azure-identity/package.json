{
  "name": "@mohsinonxrm/dataverse-sdk-auth-azure-identity",
  "version": "2.0.0",
  "description": "Azure Identity authentication provider for Dataverse SDK",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-auth-azure-identity"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dataverse",
    "dynamics365",
    "authentication",
    "azure-identity",
    "managed-identity"
  ],
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@azure/identity": "^4.0.0"
  },
  "devDependencies": {
    "@azure/identity": "^4.14.1",
    "@mohsinonxrm/dataverse-sdk-testing": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
