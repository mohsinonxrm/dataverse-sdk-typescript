{
  "name": "@mohsinonxrm/dataverse-sdk-files",
  "version": "2.0.1",
  "type": "module",
  "author": "Mohsin On xRM",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsinonxrm/dataverse-sdk-typescript.git",
    "directory": "packages/dataverse-sdk-files"
  },
  "description": "File and image column operations for Dataverse Web API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
