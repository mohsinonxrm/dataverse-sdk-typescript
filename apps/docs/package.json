{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site (VitePress): the guides in docs/, the package READMEs and a TypeDoc API reference, served at /docs on the explorer site",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "content": "node scripts/content.mjs",
    "api": "typedoc",
