# Environment Configuration for SDK Type Generation

# Dataverse environment URL (required)
# Example: https://org.crm.dynamics.com
DATAVERSE_URL=

# Azure AD App Registration (required for authentication)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Optional: Control what gets generated
# Comma-separated list: metadata,messages,actions,functions
# Leave empty to generate all
# GENERATE_TARGETS=metadata,actions

# Optional: Output paths (defaults shown)
# METADATA_OUTPUT_PATH=../../packages/dataverse-sdk-metadata/src/types
# MESSAGES_OUTPUT_PATH=../../packages/dataverse-sdk-messages/src
# ACTIONS_OUTPUT_PATH=../../packages/dataverse-sdk-actions/src
# FUNCTIONS_OUTPUT_PATH=../../packages/dataverse-sdk-functions/src
