{
  "name": "generate-sdk-types",
  "version": "1.0.0",
  "private": true,
  "description": "Internal tool for generating SDK types from Dataverse $metadata",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "generate-sdk-types": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "generate": "node dist/cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@mohsinonxrm/dataverse-sdk-core": "workspace:*",
    "@mohsinonxrm/dataverse-sdk-auth-azure-identity": "workspace:*",
    "commander": "^13.0.0",
    "dotenv": "^16.5.1",
    "ejs": "^4.0.0",
    "fast-xml-parser": "^5.11.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
